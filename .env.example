# VectorPath environment contract. Names and safe defaults only — real values go in .env.local (ignored).
# Never give a secret a NEXT_PUBLIC_ prefix.

# Database (U03). Pooled runtime target and direct migration target.
DATABASE_URL=
DIRECT_URL=
# Explicit isolated integration/E2E target; never production.
TEST_DATABASE_URL=
# Local Docker (npm run db:up): non-secret dev defaults
# DATABASE_URL=postgresql://vectorpath:vectorpath_local@127.0.0.1:55432/vectorpath
# DIRECT_URL=postgresql://vectorpath:vectorpath_local@127.0.0.1:55432/vectorpath
# TEST_DATABASE_URL=postgresql://vectorpath:vectorpath_local@127.0.0.1:55433/vectorpath_test

# HMAC secret for privacy-safe request-limit keys (32+ random bytes).
SESSION_SECRET=
# Public app origin used for origin checks. Not a secret.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# live | fixtures — development and tests default to fixtures.
DATA_MODE=fixtures
# live | mock — tests default to mock; mock is never real-user extraction.
LLM_MODE=mock

# Groq is optional and unused in free demo mode.
PERSONAL_LLM_ENABLED=false
LLM_PERSONAL_PROVIDER=
LLM_PERSONAL_MODEL=
GROQ_API_KEY=

# Gemini switch (architecture §12.1). unpaid (default): offline public tasks only, never personal data.
# paid: personal tasks for all regions — only with a key and LLM_MODE=live. Configuration only, no code change.
GEMINI_TIER=unpaid
GEMINI_API_KEY=
LLM_GENERAL_MODEL=gemini-2.5-flash

# Pinned reference embedding identity (vectors are L2-normalized manually).
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
EMBEDDING_TASK_TYPE=SEMANTIC_SIMILARITY

# Adzuna — one team account; optional when data unavailable.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Effective caps: lower of these and the verified account quota.
ADZUNA_LIMIT_MINUTE=20
ADZUNA_LIMIT_DAY=200
ADZUNA_LIMIT_WEEK=900
ADZUNA_LIMIT_MONTH=2300

# Lightcast — approved offline seed access only.
LIGHTCAST_CLIENT_ID=
LIGHTCAST_CLIENT_SECRET=

# Verified quota-derived global analysis limit; live mode fails closed when unset.
CV_ANALYZE_DAILY_CAP=
