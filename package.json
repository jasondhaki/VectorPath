{
  "name": "vectorpath",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && node scripts/check-tokens.mjs",
    "test:unit": "vitest run --project unit",
    "test:integration": "node scripts/require-test-db.mjs && vitest run --project integration",
    "test": "npm run test:unit && npm run test:integration",
    "test:e2e": "playwright test",
    "check:docs": "node scripts/check-docs.mjs",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "prisma migrate dev --create-only",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:size": "tsx --conditions=react-server scripts/db-size.ts",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "purge:stale": "node scripts/not-implemented.mjs purge:stale U19b",
    "eval": "node scripts/not-implemented.mjs eval U32b",
    "eval:capture": "node scripts/not-implemented.mjs eval:capture U32b",
    "seed:onet": "node scripts/not-implemented.mjs seed:onet U06",
    "seed:lightcast": "node scripts/not-implemented.mjs seed:lightcast U07",
    "seed:config": "node scripts/not-implemented.mjs seed:config U10",
    "seed:embed": "node scripts/not-implemented.mjs seed:embed U08",
    "seed:map-software": "node scripts/not-implemented.mjs seed:map-software U09",
    "seed:resources": "node scripts/not-implemented.mjs seed:resources U13",
    "check:links": "node scripts/not-implemented.mjs check:links U13",
    "seed:graph": "node scripts/not-implemented.mjs seed:graph U09",
    "seed:macro": "node scripts/not-implemented.mjs seed:macro U11",
    "seed:market": "node scripts/not-implemented.mjs seed:market U12",
    "seed:personas": "node scripts/not-implemented.mjs seed:personas U25",
    "seed:outlook": "node scripts/not-implemented.mjs seed:outlook U34",
    "agents:audit": "node scripts/agents/check-ownership.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.101",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ai": "7.0.146",
    "clsx": "2.1.1",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "dotenv": "18.0.8",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "unrs-resolver@1.12.2": true
  }
}
